#!/bin/bash

# Warn if an Omarchy update replaced dotfiles-owned Neovim config files.
# This hook is intentionally read-only: it does not run stow or rewrite files.

set -u

warned=0

warn() {
  warned=1
  printf 'Omarchy post-update warning: %s\n' "$1"
}

resolve_checkout() {
  local hook_path
  local candidate

  hook_path=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null) || return 1
  candidate=$(cd "$(dirname "$hook_path")/../../../.." 2>/dev/null && pwd -P) || return 1
  if [[ -d "$candidate/.git" || -f "$candidate/.git" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  # A copied hook has no repository-relative path. An explicit checkout path
  # is supported, but there is deliberately no HOME/dotfiles default.
  if [[ -n ${DOTFILES_DIR:-} ]] && [[ -d "$DOTFILES_DIR/.git" || -f "$DOTFILES_DIR/.git" ]]; then
    printf '%s\n' "$(cd "$DOTFILES_DIR" && pwd -P)"
    return 0
  fi
  return 1
}

dotfiles_dir=$(resolve_checkout 2>/dev/null || true)
if [[ -z "$dotfiles_dir" ]]; then
  warn "unable to resolve the dotfiles checkout from this hook"
  exit 0
fi

nvim_source="$dotfiles_dir/nvim/.config/nvim"
nvim_target="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
if [[ ! -d "$nvim_source" ]]; then
  warn "dotfiles checkout has no Neovim source directory: $nvim_source"
  exit 0
fi

while IFS= read -r -d '' source_file; do
  rel_path=${source_file#"$nvim_source"/}
  target_file="$nvim_target/$rel_path"
  source_real=$(readlink -f "$source_file" 2>/dev/null || true)
  target_real=$(readlink -f "$target_file" 2>/dev/null || true)

  if [[ ! -e "$target_file" ]]; then
    warn "$target_file is missing"
  elif [[ ! -L "$target_file" ]]; then
    warn "$target_file is not a stow symlink"
  elif [[ "$source_real" != "$target_real" ]]; then
    warn "$target_file points to $target_real, expected $source_real"
  fi
done < <(find "$nvim_source" -type f -print0)

if [[ "$warned" -eq 1 ]]; then
  printf '\nReview the live Neovim config against the checkout:\n'
  printf '  diff -qr %q %q\n' "$nvim_target" "$nvim_source"
fi

exit 0
