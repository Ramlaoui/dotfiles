#!/bin/sh

# Common navigation and inspection aliases. Host-specific paths belong in shell/local.
alias work='cd -- "$HOME/work"'
[ -n "${STORE:-}" ] && alias store='cd -- "$STORE"'
alias f='find . -type f -print | fzf --preview "bat --color=always --style=header,grid --line-range :500 {}"'
alias inkscape-watch='inkscape-figures watch'
alias wdir="watch -d -n 1 'ls -lah --color=auto'"
alias kilast='kill -9 %%'
alias cleangpu='pkill -9 -f "entaloracle/main.py"'
alias fixgui='sudo systemctl restart sddm'
alias al='alias | less'
alias as='alias | grep'
alias ar='unalias'
alias cpwd='copy_pwd'
alias pa='pbpaste'
alias dud='du -d 1 -h'
alias duds='du -d 1 -h | sort -h'
alias duf='du -sh *'
alias dufs='du -sh * | sort -h'
alias ff='find . -type f -name'
command -v fd >/dev/null 2>&1 || alias fd='find . -type d -name'
command -v bat >/dev/null 2>&1 && alias cat='bat'
command -v eza >/dev/null 2>&1 && alias ls='eza -la'
alias notes='nvim "$HOME/org/refile.org"'
[ -n "${OBSIDIAN_VAULT:-}" ] && alias vault='cd -- "$OBSIDIAN_VAULT"'
[ -n "${OBSIDIAN_VAULT:-}" ] && alias openvault='open -a Obsidian "$OBSIDIAN_VAULT"'
alias ssconfig='nvim "$HOME/.ssh/config"'
alias sskeys='cd -- "$HOME/.ssh" && ls -l'
alias ssgen='ssh-keygen -t rsa -b 4096 -C'
alias sscopy='ssh-copy-id'
alias ssadd='ssh-add'
alias lg='lazygit'
alias tmux='tmux -u'
alias t='tmux'
alias ta='tmux attach-session -t'
alias tn='tmux new-session -s'
alias tl='tmux list-sessions'
alias tk='tmux kill-session -t'
alias ec="emacsclient -c -n -a ''"
alias et="emacsclient -t -a ''"
alias ek="emacsclient -e '(kill-emacs)'"
alias wtl='git worktree list'
alias wta='git worktree add'
alias wtr='git worktree remove'
alias myip='curl ipv4.icanhazip.com'
alias wtp='git worktree prune'
alias wtm='git worktree move'
alias wtlock='git worktree lock'
alias wtunlock='git worktree unlock'
alias wtb='git branch -vv'
