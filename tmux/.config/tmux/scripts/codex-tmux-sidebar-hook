#!/usr/bin/env bash
set -u

plugin_hook="${TMUX_AGENT_SIDEBAR_HOOK:-}"
state_dir="${CODEX_TMUX_SIDEBAR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/codex-tmux-sidebar}"
pending_file="$state_dir/pending.json"
sessions_file="$state_dir/sessions.json"
lock_dir="$state_dir/lock.d"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
pending_max_age_seconds="${CODEX_TMUX_SIDEBAR_PENDING_MAX_AGE_SECONDS:-600}"

# shellcheck source=tmux/.config/tmux/scripts/codex-tmux-sidebar-lock
. "$script_dir/codex-tmux-sidebar-lock"

agent_name="${1:-}"
event_name="${2:-}"
input="$(cat)" || exit 1

# The upstream plugin is optional. Do not create state for an uninstalled
# integration, but report malformed state whenever the integration is active.
if [[ -z "$plugin_hook" ]] && command -v tmux >/dev/null 2>&1; then
  plugin_hook="$(tmux show-option -gqv @agent_sidebar_hook 2>/dev/null || true)"
fi
if [[ -z "$plugin_hook" ]]; then
  plugin_hook="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tmux-agent-sidebar/hook.sh"
fi
[[ -f "$plugin_hook" ]] || exit 0
command -v jq >/dev/null 2>&1 || { codex_tmux_sidebar_error "jq is required for Codex pane association"; exit 1; }
jq -e 'type == "object"' <<<"$input" >/dev/null 2>&1 || { codex_tmux_sidebar_error "hook input is not a JSON object"; exit 1; }

pane_exists() {
  [[ -n "$1" ]] && command -v tmux >/dev/null 2>&1 && tmux display-message -p -t "$1" '#{pane_id}' >/dev/null 2>&1
}

pane_claimable_for_session() {
  local target="$1" current_agent current_session
  pane_exists "$target" || return 1
  current_agent="$(tmux show-options -pt "$target" -v @pane_agent 2>/dev/null || true)"
  current_session="$(tmux show-options -pt "$target" -v @pane_session_id 2>/dev/null || true)"
  # Same-cwd Codex launches can overlap. Never let a new session claim a pane
  # already known to tmux-agent-sidebar as another Codex run.
  [[ -z "$current_agent" || "$current_agent" != "codex" || -z "$current_session" || "$current_session" == "$session_id" ]]
}

json_field() {
  local query="$1"
  jq -r "$query // empty" 2>/dev/null <<<"$input"
}

prune_dead_sessions() {
  local row sid candidate
  local rows
  rows="$(jq -r 'to_entries[] | [.key, .value.pane] | @tsv' "$sessions_file")" || return 1
  while IFS=$'\t' read -r sid candidate; do
    [[ -n "$sid" ]] || continue
    if ! pane_exists "$candidate"; then
      codex_tmux_sidebar_atomic_jq "$sessions_file" 'del(.[$sid])' --arg sid "$sid" || return 1
    fi
  done <<<"$rows"
}

claim_pending_for_session() {
  [[ -n "$session_id" && -n "$cwd" ]] || return 0
  local rows row token candidate tmp
  rows="$(jq -r \
    --arg cwd "$cwd" \
    --argjson now "$now" \
    --argjson max_age "$pending_max_age_seconds" \
    '[.[] | select(.cwd == $cwd and (($now - .created_at) < $max_age))] | reverse[] | [.token, .pane] | @tsv' \
    "$pending_file")" || return 1

  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    token="${row%%$'\t'*}"
    candidate="${row#*$'\t'}"
    if pane_claimable_for_session "$candidate"; then
      pane="$candidate"
      codex_tmux_sidebar_atomic_jq "$sessions_file" \
        '.[$sid] = {pane: $pane, cwd: $cwd, updated_at: $now}' \
        --arg sid "$session_id" --arg pane "$pane" --arg cwd "$cwd" --argjson now "$now" || return 1
      codex_tmux_sidebar_atomic_jq "$pending_file" \
        '[.[] | select(.token != $token and .pane != $pane)]' \
        --arg token "$token" --arg pane "$pane" || return 1
      return 0
    fi
  done <<<"$rows"
}

resolve_session_pane() {
  [[ -n "$session_id" ]] || return 0
  local candidate
  candidate="$(jq -r --arg sid "$session_id" '.[$sid].pane // empty' "$sessions_file")" || return 1
  if pane_exists "$candidate"; then
    pane="$candidate"
    codex_tmux_sidebar_atomic_jq "$sessions_file" '.[$sid].updated_at = $now' --arg sid "$session_id" --argjson now "$now"
    return $?
  fi
  [[ -n "$candidate" ]] || return 0
  codex_tmux_sidebar_atomic_jq "$sessions_file" 'del(.[$sid])' --arg sid "$session_id"
}

remove_session() {
  [[ -n "$session_id" ]] || return 0
  codex_tmux_sidebar_atomic_jq "$sessions_file" 'del(.[$sid])' --arg sid "$session_id"
}

session_id="$(json_field '.session_id // .sessionId')"
event_cwd="$(json_field '.cwd')"
cwd=""
if [[ -n "$event_cwd" ]]; then
  if ! cwd="$(codex_tmux_sidebar_normalize_cwd "$event_cwd")"; then
    codex_tmux_sidebar_error "ignoring inaccessible event cwd: $event_cwd"
  fi
fi
now="$(date +%s)" || { codex_tmux_sidebar_error "cannot read current time"; exit 1; }
pane=""

update_sidebar_state() {
  codex_tmux_sidebar_prune_pending "$now" "$pending_max_age_seconds" || return 1
  prune_dead_sessions || return 1
  resolve_session_pane || return 1
  if [[ "$event_name" != "stop" ]]; then
    [[ -n "$pane" ]] || claim_pending_for_session || return 1
    [[ -n "$pane" ]] || resolve_session_pane || return 1
  else
    # Preserve the association while the upstream stop event is dispatched,
    # then remove it so an exited session cannot accumulate state.
    remove_session || return 1
  fi
}

codex_tmux_sidebar_with_state_lock update_sidebar_state || exit 1
if [[ -n "$pane" ]]; then
  TMUX_PANE="$pane" bash "$plugin_hook" "$agent_name" "$event_name" <<<"$input"
else
  bash "$plugin_hook" "$agent_name" "$event_name" <<<"$input"
fi
