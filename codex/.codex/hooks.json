{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash -lc 'helper=\"${CODEX_TMUX_SIDEBAR_HOOK_HELPER:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/scripts/codex-tmux-sidebar-hook}\"; exec \"$helper\" codex activity-log'",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash -lc 'helper=\"${CODEX_TMUX_SIDEBAR_HOOK_HELPER:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/scripts/codex-tmux-sidebar-hook}\"; exec \"$helper\" codex session-start'",
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash -lc 'helper=\"${CODEX_TMUX_SIDEBAR_HOOK_HELPER:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/scripts/codex-tmux-sidebar-hook}\"; exec \"$helper\" codex stop'",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash -lc 'helper=\"${CODEX_TMUX_SIDEBAR_HOOK_HELPER:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/scripts/codex-tmux-sidebar-hook}\"; exec \"$helper\" codex user-prompt-submit'",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
