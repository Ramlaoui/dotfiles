[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata
ConditionPathExists=%E/kanata/config.kbd

[Service]
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin
# Use exec-style systemd argument handling rather than a shell command
# substitution.  This avoids PATH text becoming executable shell syntax.
ExecStart=/usr/bin/env kanata --cfg %E/kanata/config.kbd
Restart=on-failure

[Install]
WantedBy=default.target