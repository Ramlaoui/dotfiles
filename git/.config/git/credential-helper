#!/bin/sh

# Git credential helpers receive one operation and the protocol on stdin.
# Prefer encrypted OS-backed stores, then use Git's in-memory cache daemon.
operation=${1:-}
case "$operation" in
    get|store|erase) ;;
    *) exit 0 ;;
esac

for helper in git-credential-osxkeychain git-credential-libsecret; do
    if command -v "$helper" >/dev/null 2>&1; then
        exec "$helper" "$operation"
    fi
done

exec git credential-cache --timeout=900 "$operation"
